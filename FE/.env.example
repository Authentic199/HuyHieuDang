# Địa chỉ gốc của API. Để trống hoặc /api thì dùng proxy của Vite khi chạy dev,
# và dùng cùng tên miền khi chạy sau nginx trong docker-compose.
VITE_API_BASE_URL=/api

# Chỉ dùng khi chạy npm run dev: BE đang nghe ở đâu (mục 1.1 hợp đồng API).
VITE_DEV_API_PROXY=http://localhost:8080

# Đặt true để chạy giao diện bằng dữ liệu giả, không cần Backend.
# Tài khoản khi chạy dữ liệu giả: admin / admin.
VITE_USE_MOCK=false
