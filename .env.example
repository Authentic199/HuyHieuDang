# Sao chép tệp này thành .env rồi điền giá trị thật. KHÔNG commit tệp .env.

# ----- PostgreSQL -----
POSTGRES_DB=huyhieudang
POSTGRES_USER=huyhieudang
POSTGRES_PASSWORD=doi_mat_khau_nay
POSTGRES_PORT=5432

# ----- Backend -----
ASPNETCORE_ENVIRONMENT=Development
BE_PORT=8080
# Khoá ký JWT — sinh chuỗi ngẫu nhiên đủ dài cho mỗi môi trường
JWT_KEY=doi_khoa_nay_thanh_chuoi_ngau_nhien_du_dai
JWT_REFRESH_KEY=doi_khoa_refresh_nay_thanh_chuoi_ngau_nhien_du_dai
# Mật khẩu tài khoản admin seed sẵn (tên đăng nhập: admin).
# Chỉ dùng khi tạo mới bản ghi; đổi biến này sau khi đã seed thì mật khẩu cũ vẫn giữ nguyên.
ADMIN_PASSWORD=Admin@123
# Tài khoản Basic Auth để mở trang tài liệu API (/docs)
SWAGGER_USERNAME=admin
SWAGGER_PASSWORD=doi_mat_khau_nay

# ----- Frontend -----
FE_PORT=3000
